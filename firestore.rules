rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOrgMember(orgId) {
      return isSignedIn() && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }

    function isOrgOwner(orgId) {
      return isSignedIn() && exists(/databases/$(database)/documents/orgs/$(orgId)) && get(/databases/$(database)/documents/orgs/$(orgId)).data.ownerUid == request.auth.uid;
    }

    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isDecisionAnonymous(decisionId) {
      let d = get(/databases/$(database)/documents/decisions/$(decisionId));
      return d.data.keys().hasAll(['isAnonymous']) && d.data.isAnonymous == true;
    }

    function isDecisionActive(data) {
      return (!('status' in data) || data.status == 'active') &&
        (!('deadlineTs' in data) || request.time < data.deadlineTs);
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMemberData(data, memberId) {
      return data.keys().hasAll(['uid', 'role', 'name', 'email', 'joinedAt']) &&
        data.keys().hasOnly(['uid', 'role', 'name', 'email', 'joinedAt', 'avatar', 'status', 'code']) &&
        data.uid == memberId &&
        data.role in ['owner', 'member'] &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.email is string && data.email.size() <= 254 &&
        data.joinedAt is string && data.joinedAt.size() <= 64 &&
        (!data.keys().hasAny(['avatar']) || (data.avatar is string && data.avatar.size() <= 2048)) &&
        (!data.keys().hasAny(['status']) || (data.status is string && data.status.size() <= 32)) &&
        (!data.keys().hasAny(['code']) || (data.code is string && data.code.size() <= 32));
    }

    function isValidInviteCode(orgId, code) {
      return code is string &&
        code.size() > 0 &&
        code.size() <= 32 &&
        exists(/databases/$(database)/documents/inviteCodes/$(code)) &&
        get(/databases/$(database)/documents/inviteCodes/$(code)).data.orgId == orgId &&
        get(/databases/$(database)/documents/orgs/$(orgId)).data.inviteCode == code;
    }

    function isValidVoteData(data, decisionData) {
      return data.keys().hasAll(['createdAt']) &&
        data.keys().hasOnly(['userId', 'voterName', 'optionIds', 'rating', 'createdAt']) &&
        (!('userId' in data) || data.userId == request.auth.uid) &&
        data.createdAt == request.time &&
        (!('voterName' in data) || (data.voterName is string && data.voterName.size() > 0 && data.voterName.size() <= 60)) &&
        (
          (
            decisionData.type == 'rating' &&
            !('optionIds' in data) &&
            data.keys().hasAll(['rating']) &&
            data.rating is int &&
            data.rating >= 1 &&
            data.rating <= 5
          ) ||
          (
            decisionData.type in ['single', 'multiple', 'yes_no'] &&
            !('rating' in data) &&
            data.keys().hasAll(['optionIds']) &&
            data.optionIds is list &&
            data.optionIds.size() >= 1 &&
            data.optionIds.size() <= 50 &&
            data.optionIds[0] is string &&
            data.optionIds[0].size() <= 64 &&
            (decisionData.type == 'multiple' || data.optionIds.size() == 1)
          )
        );
    }

    function isVoteCounterUpdate() {
      let keys = incoming().diff(existing()).affectedKeys();
      return keys.hasAny(['options', 'totalVotes']) &&
        keys.hasOnly(['options', 'totalVotes', 'averageRating', 'participants']) &&
        incoming().options is list &&
        (
          incoming().options.size() == existing().options.size() ||
          (existing().type == 'rating' && existing().options.size() == 0 && incoming().options.size() == 5)
        ) &&
        incoming().totalVotes is int &&
        incoming().totalVotes >= 0 &&
        (!('totalVotes' in existing()) || incoming().totalVotes >= existing().totalVotes) &&
        (
          !keys.hasAny(['averageRating']) ||
          (
            existing().type == 'rating' &&
            incoming().averageRating is number &&
            incoming().averageRating >= 0 &&
            incoming().averageRating <= 5
          )
        ) &&
        (
          !keys.hasAny(['participants']) ||
          (
            (!('isAnonymous' in existing()) || existing().isAnonymous == false) &&
            incoming().participants is list &&
            incoming().participants.size() <= 200
          )
        );
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    match /inviteCodes/{code} {
      allow get: if isSignedIn() && !isAnonymous() && isValidId(code);
      allow list: if false;
      allow create: if isSignedIn() && !isAnonymous() && isValidId(code) && isOrgOwner(incoming().orgId);
      allow update, delete: if isSignedIn() && !isAnonymous() && isValidId(code) && isOrgOwner(existing().orgId);
    }

    match /orgs/{orgId} {
      allow read: if isValidId(orgId) && isOrgMember(orgId);
      allow create: if isSignedIn() && !isAnonymous() && isValidId(orgId) && incoming().ownerUid == request.auth.uid;
      allow update, delete: if isValidId(orgId) && isOrgOwner(orgId);

      match /members/{memberId} {
        allow read: if isValidId(orgId) && isOrgMember(orgId);
        allow create: if isSignedIn() && !isAnonymous() &&
          isValidId(orgId) && isValidId(memberId) &&
          isValidMemberData(incoming(), memberId) &&
          (
            (
              isOrgOwner(orgId) &&
              (
                incoming().role == 'member' ||
                (incoming().role == 'owner' && memberId == get(/databases/$(database)/documents/orgs/$(orgId)).data.ownerUid)
              )
            ) ||
            (
              request.auth.uid == memberId &&
              incoming().role == 'member' &&
              incoming().keys().hasAll(['code']) &&
              isValidInviteCode(orgId, incoming().code)
            )
          );
        allow update: if isSignedIn() && !isAnonymous() &&
          isValidId(orgId) && isValidId(memberId) &&
          isValidMemberData(incoming(), memberId) &&
          incoming().uid == existing().uid &&
          (
            (
              isOrgOwner(orgId) &&
              (
                incoming().role == 'member' ||
                (incoming().role == 'owner' && memberId == get(/databases/$(database)/documents/orgs/$(orgId)).data.ownerUid)
              )
            ) ||
            (
              request.auth.uid == memberId &&
              incoming().role == existing().role &&
              !incoming().diff(existing()).affectedKeys().hasAny(['role', 'uid'])
            )
          );
        allow delete: if isSignedIn() && !isAnonymous() &&
          isValidId(orgId) && isValidId(memberId) &&
          (isOrgOwner(orgId) || request.auth.uid == memberId);
      }
    }

    match /decisions/{decisionId} {
      allow get: if isSignedIn() && isValidId(decisionId) && (
        resource == null ||
        resource.data.audience == 'link' ||
        (!isAnonymous() && isOrgMember(resource.data.orgId) && (
          resource.data.audience == 'org' ||
          (resource.data.audience == 'private' && resource.data.creator.uid == request.auth.uid)
        ))
      );

      allow list: if isSignedIn() && !isAnonymous() &&
        isOrgMember(resource.data.orgId) && (
          resource.data.audience in ['org', 'link'] ||
          (resource.data.audience == 'private' && resource.data.creator.uid == request.auth.uid)
        );

      allow create: if isSignedIn() && !isAnonymous() &&
        isValidId(decisionId) &&
        incoming().orgId is string &&
        incoming().orgId.size() <= 128 &&
        isOrgMember(incoming().orgId) &&
        incoming().creator is map &&
        incoming().creator.uid == request.auth.uid &&
        incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 150 &&
        incoming().description is string && incoming().description.size() <= 3000 &&
        incoming().type in ['single', 'multiple', 'yes_no', 'rating'] &&
        incoming().audience in ['org', 'private', 'link'] &&
        (!('status' in incoming()) || incoming().status == 'active') &&
        (!('totalVotes' in incoming()) || incoming().totalVotes == 0);

      allow update: if isSignedIn() && isValidId(decisionId) && (
        (
          isDecisionActive(existing()) &&
          isVoteCounterUpdate() &&
          !exists(/databases/$(database)/documents/decisions/$(decisionId)/votes/$(request.auth.uid)) &&
          existsAfter(/databases/$(database)/documents/decisions/$(decisionId)/votes/$(request.auth.uid)) &&
          (
            existing().audience == 'link' ||
            (
              !isAnonymous() &&
              isOrgMember(existing().orgId) &&
              (existing().audience != 'private' || existing().creator.uid == request.auth.uid)
            )
          )
        ) ||
        (
          !isAnonymous() &&
          isOrgMember(existing().orgId) && (
            (
              (existing().creator.uid == request.auth.uid || isOrgOwner(existing().orgId)) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['deadline', 'deadlineTs', 'status', 'finalDecision']) &&
              (!('status' in incoming()) || incoming().status in ['active', 'closed']) &&
              (!('deadline' in incoming()) || (incoming().deadline is string && incoming().deadline.size() <= 64))
            ) ||
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['comments']) &&
              incoming().comments is list &&
              incoming().comments.size() > 0 &&
              incoming().comments.size() <= 500 &&
              incoming().comments[incoming().comments.size() - 1].uid == request.auth.uid
            )
          )
        )
      );

      allow delete: if isSignedIn() && !isAnonymous() && isValidId(decisionId) && (existing().creator.uid == request.auth.uid || isOrgOwner(existing().orgId));

      match /votes/{voteId} {
        allow get: if isSignedIn() && isValidId(decisionId) && isValidId(voteId) && (
          voteId == request.auth.uid ||
          (!isAnonymous() && !isDecisionAnonymous(decisionId))
        ) && (
          get(/databases/$(database)/documents/decisions/$(decisionId)).data.audience == 'link' ||
          (!isAnonymous() && isOrgMember(get(/databases/$(database)/documents/decisions/$(decisionId)).data.orgId))
        );

        allow list: if isSignedIn() && !isAnonymous() && isValidId(decisionId) &&
          !isDecisionAnonymous(decisionId) &&
          isOrgMember(get(/databases/$(database)/documents/decisions/$(decisionId)).data.orgId);

        allow create: if isSignedIn() &&
          isValidId(decisionId) && isValidId(voteId) &&
          voteId == request.auth.uid &&
          exists(/databases/$(database)/documents/decisions/$(decisionId)) &&
          isDecisionActive(get(/databases/$(database)/documents/decisions/$(decisionId)).data) &&
          isValidVoteData(incoming(), get(/databases/$(database)/documents/decisions/$(decisionId)).data) &&
          (
            get(/databases/$(database)/documents/decisions/$(decisionId)).data.audience == 'link' ||
            (
              !isAnonymous() &&
              isOrgMember(get(/databases/$(database)/documents/decisions/$(decisionId)).data.orgId) &&
              (
                get(/databases/$(database)/documents/decisions/$(decisionId)).data.audience != 'private' ||
                get(/databases/$(database)/documents/decisions/$(decisionId)).data.creator.uid == request.auth.uid
              )
            )
          );

        allow update, delete: if false;
      }
    }
  }
}
