rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'gestsocialgabriele@gmail.com';
    }

    function isCreator() {
      return isSignedIn() && resource != null && resource.data.creator.uid == request.auth.uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Decisions collection
    match /decisions/{decisionId} {
      // Read allowed to signed in users if public, restricted, or created by the user (or admin)
      allow read: if isSignedIn() && (
        isAdmin() ||
        existing().audience == 'public' ||
        existing().audience == 'restricted' ||
        (existing().keys().hasAll(['creator']) && existing().creator.uid == request.auth.uid)
      );

      // Create allowed to signed-in users setting themselves as creator
      allow create: if isSignedIn() &&
        incoming().creator.uid == request.auth.uid &&
        incoming().title is string && incoming().title.size() <= 150 &&
        incoming().description is string && incoming().description.size() <= 3000;

      // Update allowed to creator, admin, or voting/commenting by signed in users
      allow update: if isSignedIn() && (
        isCreator() ||
        isAdmin() ||
        // Action: Commenting
        incoming().diff(existing()).affectedKeys().hasOnly(['comments']) ||
        // Action: Voting (allowed only if user has not already voted)
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['votes', 'options'])
        )
      );

      // Delete allowed only to decision creator or admin
      allow delete: if isAdmin() || isCreator();
    }

    // Members collection
    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
