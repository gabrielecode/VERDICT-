rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'gestsocialgabriele@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation
    function isValidDecision(data) {
      return data.keys().hasAll(['title', 'description', 'category', 'type', 'deadline', 'creator', 'options']) &&
             data.title is string && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 1000 &&
             data.creator.uid == request.auth.uid;
    }

    function isValidMember(data) {
      return data.keys().hasAll(['name', 'surname', 'department', 'email', 'role', 'status']) &&
             data.name is string && data.surname is string &&
             data.email is string && data.role is string && data.status is string;
    }

    // Collections
    match /decisions/{decisionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isEmailVerified() && isValidDecision(incoming());
      allow update: if isSignedIn() && (
        // Action: Vote or Comment (self-modification of nested arrays)
        // We allow the creator or any verified user to update votes/comments as long as the schema is valid
        (isValidDecision(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['votes', 'options']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['comments'])
        )) ||
        // Action: Admin extension or modification
        isAdmin()
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().creator.uid == request.auth.uid);
    }

    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
