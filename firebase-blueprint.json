{
  "entities": {
    "Decision": {
      "title": "Decision",
      "description": "A decision proposal with options and vote counters",
      "type": "object",
      "properties": {
        "orgId": {
          "type": "string",
          "maxLength": 128,
          "description": "Organization ID"
        },
        "title": {
          "type": "string",
          "maxLength": 150,
          "description": "Title of the decision"
        },
        "description": {
          "type": "string",
          "maxLength": 3000,
          "description": "Context and details"
        },
        "category": {
          "type": "string",
          "description": "Topic category"
        },
        "type": {
          "type": "string",
          "enum": ["single", "multiple", "yes_no", "rating"],
          "description": "Type of voting mechanism"
        },
        "status": {
          "type": "string",
          "enum": ["active", "closed"],
          "description": "Proposal voting status"
        },
        "deadline": {
          "type": "string",
          "format": "date-time",
          "description": "When voting closes"
        },
        "audience": {
          "type": "string",
          "enum": ["org", "private", "link"],
          "description": "Visibility level"
        },
        "isAnonymous": {
          "type": "boolean",
          "description": "Whether votes are anonymous"
        },
        "totalVotes": {
          "type": "number",
          "description": "Total vote count"
        },
        "averageRating": {
          "type": "number",
          "description": "Average rating for rating proposals"
        },
        "creator": {
          "type": "object",
          "description": "Creator metadata"
        },
        "options": {
          "type": "array",
          "description": "List of options with vote counts"
        },
        "participants": {
          "type": "array",
          "description": "List of non-anonymous participants"
        },
        "comments": {
          "type": "array",
          "description": "List of comments"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["orgId", "title", "description", "category", "type", "status", "deadline", "audience", "creator", "options"]
    },
    "DecisionVote": {
      "title": "DecisionVote",
      "description": "A user vote document stored under decisions/{decisionId}/votes/{uid}",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Voter UID"
        },
        "voterName": {
          "type": "string",
          "maxLength": 60,
          "description": "Optional voter display name"
        },
        "optionIds": {
          "type": "array",
          "description": "Selected option IDs for single/multiple/yes_no"
        },
        "rating": {
          "type": "number",
          "description": "Star rating from 1 to 5 for rating proposals"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of vote creation"
        }
      },
      "required": ["createdAt"]
    },
    "Member": {
      "title": "Member",
      "description": "An organization member profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "member"] },
        "avatar": { "type": "string" },
        "joinedAt": { "type": "string" }
      },
      "required": ["uid", "name", "email", "role", "joinedAt"]
    }
  },
  "firestore": {
    "/decisions/{decisionId}": {
      "schema": { "$ref": "#/entities/Decision" },
      "description": "Collection of all decision proposals"
    },
    "/decisions/{decisionId}/votes/{voteId}": {
      "schema": { "$ref": "#/entities/DecisionVote" },
      "description": "Per-user vote records keyed by voter UID"
    },
    "/orgs/{orgId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/Member" },
      "description": "Organization member directory"
    }
  }
}
